# Core Flask settings
SECRET_KEY=replace-with-a-long-random-secret
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# PostgreSQL settings
DB_HOST=your-postgres-host
DB_NAME=uk_pm_monitoring
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_PORT=5432

# Optional single-url style database config
# DATABASE_URL=postgresql://user:password@host:5432/uk_pm_monitoring

# Session / deployment mode
APP_ENV=production
PLATFORM=zoho

# MQTT broker settings are normally stored in dust_data_sources table,
# but keeping these here helps for first bootstrap/testing.
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
